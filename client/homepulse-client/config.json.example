{
  "heartbeat": {
    "interval_minutes": 1,
    "whoami_url": "https://<region>-<project>.cloudfunctions.net/whoami"
  },
  "speedtest": {
    "provider": "cloudflare",
    "librespeed_url": null,
    "timeout_seconds": 60,
    "interval_minutes": 60,
    "whoami_url": "https://<region>-<project>.cloudfunctions.net/whoami"
  },
  "ingest": {
    "api_key": "hpk_<household_id>_<random>",
    "household_id": "YOUR_HOUSEHOLD_ID",
    "heartbeat_url": "https://<region>-<project>.cloudfunctions.net/ingest-heartbeat",
    "speedtest_url": "https://<region>-<project>.cloudfunctions.net/ingest-speedtest"
  },
  "log": {
    "path": "/var/log/speedtest-logger.log",
    "level": "info"
  }
}
