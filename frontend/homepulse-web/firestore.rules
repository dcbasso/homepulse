rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Lets a signed-in user discover which households they belong to via a
    // collectionGroup query on `members`, filtered by their own uid or
    // email (see HouseholdContextService.resolveMembershipsFor). Safe as a
    // collection-group rule because it mirrors the query's own equality
    // filter — it can never expose another user's member entry.
    match /{path=**}/members/{memberId} {
      allow read: if request.auth != null
        && (resource.data.uid == request.auth.uid || resource.data.email == request.auth.token.email);
    }

    match /households/{householdId} {
      function isMember() {
        return request.auth != null
          && exists(/databases/$(database)/documents/households/$(householdId)/members/$(request.auth.uid));
      }

      function isOwnerOrAdmin() {
        return isMember()
          && get(/databases/$(database)/documents/households/$(householdId)/members/$(request.auth.uid)).data.role in ['owner', 'admin'];
      }

      allow read: if isMember();

      // Membership changes (granting/revoking access) are restricted to
      // owner/admin — enforced here, not just in the Members screen's UI.
      //
      // Exception: a signed-in user may create their own uid-keyed member
      // doc without already being owner/admin, but only when an existing
      // email-keyed doc for their own address is already present in this
      // household — i.e. claiming an invitation placed by an admin (or by
      // the one-shot migration script, ADR 0009), never self-elevating.
      // See HouseholdContextService.claimMembership.
      match /members/{memberId} {
        // An owner/admin editing their own existing member doc may not
        // change their own `role` — otherwise the last owner/admin of a
        // household could accidentally (or deliberately) lock themselves
        // out with no one left able to grant access back.
        function isSelfRoleChange() {
          return request.auth.uid == memberId
            && resource != null
            && request.resource.data.role != resource.data.role;
        }

        allow read: if isMember();
        allow write: if (isOwnerOrAdmin() && !isSelfRoleChange())
          || (request.auth != null
              && request.auth.uid == memberId
              && request.auth.token.email != null
              && exists(/databases/$(database)/documents/households/$(householdId)/members/$(request.auth.token.email)));
      }

      match /heartbeats/{doc} {
        allow read: if isMember();
      }

      match /speedtest_results/{doc} {
        allow read: if isMember();
      }

      match /incidents/{doc} {
        allow read: if isMember();
      }

      match /monitor_config/{doc} {
        allow read, write: if isMember();
      }
    }
  }
}
